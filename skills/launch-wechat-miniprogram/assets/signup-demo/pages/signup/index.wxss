page { background: #f5f7fb; color: #17212f; }
.page { min-height: 100vh; padding: 32rpx 28rpx calc(44rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.hero { padding: 24rpx 8rpx 34rpx; }.eyebrow { display: block; color: #607086; font-size: 22rpx; letter-spacing: 2rpx; }.title { display: block; font-size: 50rpx; font-weight: 700; margin-top: 8rpx; }.intro,.muted,.optional { color: #627084; font-size: 25rpx; }.intro { display: block; margin-top: 12rpx; line-height: 1.6; }
.card { background: #fff; border-radius: 20rpx; padding: 28rpx; margin-bottom: 20rpx; box-shadow: 0 6rpx 18rpx rgba(20,45,75,.05); }.row,.label-row,.summary { display:flex; justify-content:space-between; gap:16rpx; align-items:center; }.seat { color:#216c4a; background:#e8f6ee; padding:6rpx 12rpx; border-radius:10rpx; font-size:23rpx; }.muted { display:block; margin-top:12rpx; }.label { font-weight:650; }.switcher,.actions { display:flex; gap:16rpx; margin-top:18rpx; }.user,.plain { flex:1; background:#f1f4f8; color:#314158; border-radius:12rpx; font-size:27rpx; }.user.selected { background:#dce9ff; color:#1357ba; font-weight:650; }.user::after,.plain::after,.primary::after,.link::after { border:0; } textarea { width:100%; min-height:150rpx; box-sizing:border-box; margin-top:18rpx; padding:18rpx; background:#f7f9fc; border:1rpx solid #d7e0ec; border-radius:12rpx; font-size:28rpx; }.primary { background:#1769e0; color:#fff; margin-top:20rpx; border-radius:12rpx; font-weight:650; }.status { display:block; min-height:38rpx; margin-top:16rpx; font-size:25rpx; }.success { color:#198754; }.error { color:#c23432; }.quiet { color:#627084; }.count { color:#1769e0; font-weight:700; }.link { padding:10rpx; background:transparent; color:#38669e; font-size:26rpx; }.danger { color:#a04a4a; }
