page {background:#f5f4ef;color:#1b2829}
.casebook {padding:32rpx}
.tabs,.modes,.links,.row {display:flex;align-items:center}
.casebook button {margin:0;border-radius:10rpx;font-size:28rpx;font-weight:500;line-height:1.5;padding:18rpx 20rpx}
.casebook button::after {border:0}
.tabs {gap:8rpx}.tabs button {flex:1;background:transparent;color:#52615e}.tabs .active {background:#d6e8dc;color:#194936}
.title {font-size:48rpx;line-height:1.3;font-weight:700;margin:50rpx 0 32rpx}
.modes {gap:12rpx}.modes button {background:#e8e8df}.modes .selected,.casebook .primary {background:#214c3c;color:white}
.paper {padding:34rpx;margin:28rpx 0;background:#fff;border:1px solid #d7dcd4;border-radius:22rpx}
.heading {font-size:34rpx;font-weight:700;margin-bottom:25rpx}.row {justify-content:space-between;padding:24rpx 0;border-bottom:1px solid #d7dcd4}.row text {color:#306348}
.links {justify-content:center;margin-top:28rpx}.links button {color:#245841;background:transparent;text-decoration:underline}
.casebook .menu,.casebook .room {text-align:left;width:100%;margin-top:12rpx;background:#f4f4ee}
.casebook label {display:block;font-size:26rpx;margin-top:18rpx}.casebook input {border:1px solid #717e72;border-radius:8rpx;padding:14rpx;margin:8rpx 0;font-size:30rpx}
.casebook .primary {margin:24rpx 0 14rpx}.error {color:#9d3523;font-size:26rpx}.scroll {height:380rpx}
.explain {font-size:28rpx;color:#46544e;line-height:1.7}
